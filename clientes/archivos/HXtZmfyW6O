function anularTicket(){
	var labelNumeroTicket=document.getElementById('labelNumeroTicketsDetalle');
	if (labelNumeroTicket==null)return;
	var labelTicketDetalleMarca=document.getElementById('labelTicketDetalleMarca');
	if (labelTicketDetalleMarca!=null&&labelTicketDetalleMarca.innerHTML=='Devuelto'){
		mostrarDialogoAdvertencia('No se puede devolver un ticket devuelto');
		return;
	}
	if (labelTicketDetalleMarca!=null&&labelTicketDetalleMarca.innerHTML=='Anulado'){
		var idTicket=labelNumeroTicket.getAttribute('mysqlId');
		query="UPDATE tickets SET marca='' WHERE id=" +idTicket;
		enviarQuery(query,false);
		añadirStock(idTicket);
		query="SELECT pago FROM tickets WHERE id=" + idTicket;
		var tipoPago=enviarQuery(query,false);
		if (tipoPago==1) return;
		var total=document.getElementById('labelTotalTicketsDetalle').getAttribute('total');
		query="SELECT ticket FROM movimientosCaja WHERE ticket="+idTicket;
		var resultado=enviarQuery(query,false);
		resultado=String.trim(resultado);
		if (resultado!='') insertarMovimientoCaja(idTicket,total,undefined,"Cancelar Anular ticket nº:"+idTicket);
		actualizarDatosTickets();
		return;
	}
	var idTicket=labelNumeroTicket.getAttribute('mysqlId');
	query="UPDATE tickets SET marca='Anulado' WHERE id=" +idTicket;
	enviarQuery(query,false);
	devolverStock(idTicket);
	query="SELECT pago FROM tickets WHERE id=" + idTicket;
	var tipoPago=enviarQuery(query,false);
	if (tipoPago==1) return;
	var total=document.getElementById('labelTotalTicketsDetalle').getAttribute('total');
	query="SELECT ticket FROM movimientosCaja WHERE ticket="+idTicket;
	var resultado=enviarQuery(query,false);
	resultado=String.trim(resultado);
	if (resultado!='')	insertarMovimientoCaja(idTicket,-total,undefined,"Anulación ticket nº:"+idTicket);
 	actualizarDatosTickets();
}
