function devolverFechaMysql(fecha){
	var now = new Date();
	if (fecha!=null) now=new Date(fecha);
	var meses=now.getMonth()+1;
	return now.getFullYear() + "-" + meses + "-" + now.getDate();
}
function devolverFechaHoraMysql(fecha){
	var now = new Date();
	if (fecha!=null) now=new Date(fecha);
	var meses=now.getMonth() + 1;
	return now.getFullYear() + "-" + meses + "-" + now.getDate() + " " + now.getHours() + ":" + now.getMinutes() + ":" + now.getSeconds();
}
