function cargarFechaHora(){
	var fecha=new Date();
	var segundos=fecha.getSeconds();
	var minutos=fecha.getMinutes();
	var horas=fecha.getHours();
	var diaMes=fecha.getDate();
	
	var dia=fecha.getDay();
	switch(dia)
	{
	case 0:
		dia='Domingo';
		break;
	case 1:
		dia='Lunes';
		break;
	case 2:
		dia='Martes';
		break;
	case 3:
		dia='Miércoles';
		break;
	case 4:
		dia='Jueves';
		break;
	case 5:
		dia='Viernes';
		break;
	case 6:
		dia='Sábado';
		break;
	}
	
	var mes=fecha.getMonth();
	switch(mes)
	{
	case 0:
		mes='Enero';
		break;
	case 1:
		mes='Febrero';
		break;
	case 2:
		mes='Marzo';
		break;
	case 3:
		mes='Abril';
		break;
	case 4:
		mes='Mayo';
		break;
	case 5:
		mes='Junio';
		break;
	case 6:
		mes='Julio';
		break;
	case 7:
		mes='Agosto';
		break;
	case 8:
		mes='Septiembre';
		break;
	case 9:
		mes='Octubre';
		break;
	case 10:
		mes='Noviembre';
		break;
	case 11:
		mes='Diciembre';
		break;
	}
	var año=fecha.getFullYear();
	var cadenaFecha=dia + ", " + diaMes + " de " + mes + " de " + año + " " + horas + ":" + minutos + ":" + segundos;
	var labelFecha=document.getElementById('labelDivTPVfechaHora');
	labelFecha.innerHTML=cadenaFecha;
	setTimeout("cargarFechaHora()",1000);  
}
