function enviarQuery (query,metodo,decode){ //metodo true equivale a asincronico
	var xmlhttp;
	xmlhttp=new XMLHttpRequest();
	xmlhttp.responseText=null;
	if (metodo==null||metodo==undefined) metodo=true;
	if (decode==false) xmlhttp.open("GET","./PHP/funcionesXML.php?funcion=query&query="+query+"&decode=false",metodo);
	else xmlhttp.open("GET","./PHP/funcionesXML.php?funcion=query&query="+query,metodo);
	switch (metodo){
		case false:
			xmlhttp.send();
			while (xmlhttp.responseText==null){
				sleep(50);
			}
			return xmlhttp.responseText;
		default:
			xmlhttp.send();
	}
}
