function actualizarTotalTPV(){
	var tablaArticulos=document.getElementById('tablaTPVArticulosBody');
	if (tablaArticulos.rows.length==0){
		var total=document.getElementById('labeldivTPVPanelTotalCantidad');
		total.innerHTML='0';
		return;
	}
	var cantidadTotal=0;
	for (var i=0;i<tablaArticulos.rows.length;i++){
		var row=tablaArticulos.rows[i];
		var cellSubtotal=row.cells[3];
		cantidadTotal=parseFloat(cellSubtotal.innerHTML)+cantidadTotal;
	}
	var total=document.getElementById('labeldivTPVPanelTotalCantidad');
	if (descuento!=0) cantidadTotal=cantidadTotal-(cantidadTotal*descuento/100);
	total.innerHTML=cantidadTotal.toFixed(2);
	total.style.color="yellow";
	document.getElementById('labeldivTPVPanelTotalDescripcion').innerHTML="TOTAL";
	document.getElementById('labeldivTPVPanelTotalDescripcion').style.color="yellow";
}
