Function.prototype.nuevoMetodo = function(nombre, funcion) {
    if (!this.prototype[nombre]) {
        this.prototype[nombre] = funcion;
        return this;
    }
}
 
String.nuevoMetodo('trim', function(){
    return this.replace(/^\s+|\s+$/g, '');
});
String.nuevoMetodo('replaceAt', function(index, char) {
	if (!(isNaN(char))) char=char.toString(10);	
	if (index==0) return char + this.substr(char.length);
	else return this.substr(0, index) + char + this.substr(index+char.length);
});


