}
function seleccionarComanda(divComanda){
	if (divComanda==null)return;
	try {
		var seleccionAnterior=document.getElementById('divComanda'+comandaSeleccionada);
		seleccionAnterior.setAttribute('class','divComandasDetalle');
	}
	catch (e) {
		
	}
	if (divComanda.getAttribute('id')!='divComanda'+comandaSeleccionada && comandaSeleccionada!=0){
		resetearEstiloTablaComanda(comandaSeleccionada);
	}
	divComanda.setAttribute('class','divComandasDetalleSeleccionada');
	comandaSeleccionada=divComanda.getAttribute('mysqlId');
}
function seleccionarSelectorId(selector,id){
	for (var i in selector.options){
		if (selector.options[i].value==id){
			selector.selectedIndex=i;
			return;
		}
	}
}
