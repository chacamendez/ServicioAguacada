	if (cierre.childNodes[6].hasChildNodes()) var descuentos=parseFloat(cierre.childNodes[6].firstChild.nodeValue);
	else descuentos=0;
	if (cierre.childNodes[7].hasChildNodes()) var devolucionEfectivo=parseFloat(cierre.childNodes[7].firstChild.nodeValue);
	else devolucionEfectivo=0;
	if (cierre.childNodes[8].hasChildNodes()) var devolucionTarjetas=parseFloat(cierre.childNodes[8].firstChild.nodeValue);
	else devolucionTarjetas=0;
	if (cierre.childNodes[9].hasChildNodes()) var balance=parseFloat(cierre.childNodes[9].firstChild.nodeValue);
	else balance=0;
	if (balance!=ticketsEfectivo) var DevolucionOtrosCierres=-(ticketsEfectivo-balance);
	else var  DevolucionOtrosCierres=0;
	var totalDevolucion=devolucionEfectivo+devolucionTarjetas+DevolucionOtrosCierres;
	var totalBalance=ticketsEfectivo+cambio-pagos-DevolucionOtrosCierres;
	var texto="<label>Cierre de caja nº: "+idCierre+"</label><br><label>Fecha: "+fecha+"</label><hr><label>"+
	"A) Total Efectivo:  "+ticketsEfectivo.toFixed(2)+"</label><br><label>Total Tarjetas: "+ticketsTarjeta.toFixed(2)+
	"</label><br><label>Total: "+ticketsTotal.toFixed(2)+"</label><br><hr><label>B) Pago a proveedores: "+pagos.toFixed(2)+
	"</label><br><label>C) Cambio introducido: "+cambio.toFixed(2)+"</label><br><label>Descuentos: "+descuentos.toFixed(2)+
	"</label><br><hr><label>D) Devolución Efectivo: "+devolucionEfectivo.toFixed(2)+"</label><br>"+
	"<label>E) Devolución Tarjetas: "+devolucionTarjetas.toFixed(2)+"</label><br><label>F) Devolución otros cierres: "+
	DevolucionOtrosCierres.toFixed(2)+"</label><br><label>Devolución Total (D+E+F): "+ totalDevolucion.toFixed(2) +"</label><hr><label>"+
	"Balance Caja (A+C-B-D-F): "+totalBalance.toFixed(2)+"</label><hr><label>Impuestos: </label><br>";
	var impuestos=XMLdocument.getElementsByTagName('impuesto');
	var total=0;
	for (var i in impuestos){
		if (impuestos[i].nodeType!==1)continue;
		var impuesto=impuestos[i];
		var tipo=impuesto.getAttribute('tipo');
		var base=impuesto.getAttribute('base');
		total+=parseFloat(impuesto.firstChild.nodeValue);
		var cantidad=parseFloat(impuesto.firstChild.nodeValue);
		texto+="<label>Tipo "+tipo+"% ("+base+") "+cantidad.toFixed(2)+"</label><br>";
	}
	texto+="<label>Total: "+total.toFixed(2)+"</label><br><hr>";
	divCierres.innerHTML=texto;
	divCierres.style.display='block';
		
}
